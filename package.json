        "material-ui-popup-state": "5.3.7",
        "mui-nested-menu": "4.0.3",
        "mui-tiptap": "1.31.0",
        "node-vibrant": "4.0.4",
        "notistack": "3.0.2",
        "p-limit": "7.3.3",
        "polished": "4.3.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hotkeys-hook": "5.3.3",
        "react-lazily": "0.9.2",
