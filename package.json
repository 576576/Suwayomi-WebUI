        "@tiptap/starter-kit": "3.31.4",
        "@vibrant/color": "4.0.4",
        "apollo-upload-client": "20.0.0",
        "awaitable-component": "1.0.0",
        "colorthief": "3.5.0",
        "csstype": "3.2.3",
